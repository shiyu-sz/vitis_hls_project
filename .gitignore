# Vitis HLS logs and IDE metadata
*.log
*.jou
*.jou.*
.Xil/
/*/.apc/
/*/.settings/
/*/.project
/*/.cproject
/*/.vitis_hls_log_all.xml

# HLS synthesis, simulation and exported IP products
# Keep hls.app, solution*/script.tcl and solution*/directives.tcl.
/*/solution*/.autopilot/
/*/solution*/.debug/
/*/solution*/.tcls/
/*/solution*/syn/
/*/solution*/impl/
/*/solution*/sim/
/*/solution*/csim/
/*/solution*/solution*.aps
/*/solution*/solution*.directive
/*/solution*/solution*.funcunit
/*/solution*/solution*_data.json

# Vivado project caches and run products
/*/*_ip_test/*.cache/
/*/*_ip_test/*.gen/
/*/*_ip_test/*.hw/
/*/*_ip_test/*.ioplanning/
/*/*_ip_test/*.ip_user_files/
/*/*_ip_test/*.runs/
/*/*_ip_test/*.sim/

# Generated files alongside the block design
/*/*_ip_test/*.srcs/**/*.bda
/*/*_ip_test/*.srcs/**/ui/

# The expanded custom IP is referenced by the Vivado .xpr; its ZIP is redundant.
/*/*_ip_test/ip_repo/*.zip
