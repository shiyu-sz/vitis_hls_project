# Vitis HLS logs and IDE metadata
*.log
*.jou
*.jou.*
.Xil/
/led_twinkle/.apc/
/led_twinkle/.settings/
/led_twinkle/.project
/led_twinkle/.cproject
/led_twinkle/.vitis_hls_log_all.xml

# HLS synthesis, simulation and exported IP products
# Keep hls.app, solution1/script.tcl and solution1/directives.tcl.
/led_twinkle/solution1/.autopilot/
/led_twinkle/solution1/.debug/
/led_twinkle/solution1/syn/
/led_twinkle/solution1/impl/
/led_twinkle/solution1/sim/
/led_twinkle/solution1/csim/
/led_twinkle/solution1/solution1.*
/led_twinkle/solution1/solution1_*.json

# Vivado project caches and run products
/led_twinkle/led_twinkle_ip_test/*.cache/
/led_twinkle/led_twinkle_ip_test/*.gen/
/led_twinkle/led_twinkle_ip_test/*.hw/
/led_twinkle/led_twinkle_ip_test/*.ioplanning/
/led_twinkle/led_twinkle_ip_test/*.ip_user_files/
/led_twinkle/led_twinkle_ip_test/*.runs/
/led_twinkle/led_twinkle_ip_test/*.sim/

# Generated files alongside the block design
/led_twinkle/led_twinkle_ip_test/*.srcs/**/*.bda
/led_twinkle/led_twinkle_ip_test/*.srcs/**/ui/

# The expanded custom IP is referenced by the Vivado .xpr; its ZIP is redundant.
/led_twinkle/led_twinkle_ip_test/ip_repo/*.zip
